# Dedicated, isolated asynchronous media worker. Do not start in UAT until
# its storage, DB migrations, service plan and capacity gates are verified.
FROM php:8.4.23-cli-bookworm

RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates curl ffmpeg libcurl4-openssl-dev libonig-dev libxml2-dev libpq-dev libzip-dev \
    libpng-dev libjpeg62-turbo-dev libwebp-dev \
    && docker-php-ext-configure gd --with-jpeg --with-webp \
    && docker-php-ext-install curl dom mbstring pdo_pgsql zip opcache gd exif \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /var/www/html
COPY . /var/www/html
RUN mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader --no-progress \
    && chown -R www-data:www-data storage bootstrap/cache /var/www/html
USER www-data
# This flag belongs ONLY on the isolated video queue consumer.
ENV VIDEO_WORKER_HEARTBEAT_ENABLED=true
# Keep 540s PHP timeout below 660s database visibility lease.
# Single worker per service limits transcoding resource contention.
CMD ["php", "artisan", "queue:work", "database_video", "--queue=video", "--sleep=3", "--tries=3", "--timeout=540", "--memory=128", "--no-interaction"]
